n"]]},{"start1":2688,"length1":99,"diffs":[[1,"    export function valeurBrute(): number {\n        let data = readReg(REG_DATA_GET_RAM_DATA, 4)\n"]]},{"start1":3129,"length1":54,"diffs":[[1,"     * Lit une moyenne de plusieurs valeurs brutes.\n"]]},{"start1":3189,"length1":116,"diffs":[[1,"    //% block=\"valeur brute moyenne de %mesures mesures\"\n    //% mesures.min=1 mesures.max=50 mesures.defl=10\n"]]},{"start1":3317,"length1":58,"diffs":[[1,"    export function moyenneBrute(mesures: number): number {\n"]]},{"start1":3397,"length1":74,"diffs":[[1,"        for (let i = 0; i < mesures; i++) {\n            sum += valeurBrute()\n"]]},{"start1":3511,"length1":29,"diffs":[[1,"        return sum / mesures\n"]]},{"start1":3555,"length1":34,"diffs":[[1,"     * Lit l'état du flag de tare du module.\n"]]},{"start1":3608,"length1":40,"diffs":[[1,"    //% block=\"flag tare\"\n"]]},{"start1":3652,"length1":100,"diffs":[[1,"    export function flagTare(): number {\n        let data = readReg(REG_DATA_GET_PEEL_FLAG, 1)\n"]]},{"start1":3815,"length1":43,"diffs":[[1," * Clavier matriciel passif 4x4.\n"]]},{"start1":3851,"length1":11,"diffs":[[1," * Mapping demandé :\n"]]},{"start1":3875,"length1":120,"diffs":[[1," * P0  : rangée 1,2,3,A\n * P1  : rangée 4,5,6,B\n * P2  : rangée 7,8,9,C\n * P3  : rangée *,0,#,D\n"]]},{"start1":3974,"length1":272,"diffs":[[1," * P8  : colonne 1,4,7,*\n * P13 : colonne 2,5,8,0\n * P14 : colonne 3,6,9,#\n * P15 : colonne A,B,C,D\n"]]},{"start1":4078,"length1":132,"diffs":[[1,"//% weight=95 color=#1e90ff icon=\"\\uf11c\" block=\"Clavier 4x4\"\nnamespace Clavier4x4 {\n    let derniereTouche = \"\"\n    let antiRebondMs = 80\n"]]},{"start1":4218,"length1":155,"diffs":[[1,"    function preparerBroches(): void {\n        // P3 est partagé avec la matrice LED.\n        // On désactive l'écran pour pouvoir utiliser P3 correctement.\n"]]},{"start1":4825,"length1":41,"diffs":[[1,"    function colonneHaute(): void {\n"]]},{"start1":5059,"length1":78,"diffs":[